<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.5.x: la línea con APIs estables (Jackson 2, @EntityScan clásico, Testcontainers 1.x).
        Su soporte comunitario terminó el 2026-06-30; Spring Boot 4.1.x es la siguiente versión estable y migrar
        implica Jackson 3 y módulos de arranque nuevos, así que se deja como tarea aparte.
        CONFIRMAR la última 3.5.x disponible al compilar (la versión de abajo es la que se usó al escribir esto).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.tec</groupId>
    <artifactId>SIVCR</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Redundantes para Maven (release manda), pero NetBeans los lee para fijar el nivel del editor -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <java.version>25</java.version>
        <start-class>app.SivcrApplication</start-class>
        <exec.mainClass>app.SivcrApplication</exec.mainClass>
        <!-- Fuera del BOM de Spring Boot -->
        <commons-csv.version>1.14.0</commons-csv.version>
        <poi.version>5.4.1</poi.version>
    </properties>

    <dependencies>
        <!-- API REST (IngestionController) y Jackson para JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Implementación JPA/Hibernate de Repository<T> (inserción por lotes con secuencias) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Verificación del rol ADMIN en el servidor (@PreAuthorize) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Migraciones versionadas del esquema -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- CsvParser: lectura de CSV por flujo -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <!-- ExcelParser: lectura de .xlsx por eventos (SAX), sin cargar el libro completo -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Pruebas: JUnit 5, Mockito y MockMvc vienen en este starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Prueba de integración contra PostgreSQL real en contenedor (requiere Docker) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- model.SIVCR (Hello World) también tiene main: se fija la clase de arranque real -->
                    <mainClass>${start-class}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        TEMPORAL (código de otro bloque): estos tres archivos (ya movidos a model/dto/) usan tipos que todavía
                        no existen (KPIValue, ZoneShare, HeatmapData, ParetoPoint, VictimsByGenderAge,
                        FatalityByVehicle), por lo que el proyecto no compila con ellos.
                        QUITAR estas exclusiones cuando el dueño del bloque de KPI cree esos tipos.
                    -->
                    <excludes>
                        <exclude>model/dto/KPIResult.java</exclude>
                        <exclude>model/dto/DashboardCharts.java</exclude>
                        <exclude>model/dto/PublicSummary.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Pruebas de integración (*IT.java) con Testcontainers: mvn verify. Las unitarias (*Test) corren con mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
